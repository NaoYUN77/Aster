{
  "name": "personal-agent-base-durable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "tsx --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file=.env dist/src/main.js",
    "test": "tsx --test test/*.test.ts",
    "deliveries": "node --env-file-if-exists=.env dist/src/deliveries.js"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "abort-controller": "3.0.0",
    "grammy": "1.46.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
