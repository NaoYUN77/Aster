# Secret variables (ending in _KEY or _TOKEN) use __vault_<NAME>__ placeholders in MITM mode
# (docker-compose.mitm.yml + deploy/openbao-mitm). The MITM proxy swaps each placeholder for the
# value stored at OpenBao KV path secret/aster/<NAME> on allowlisted outbound hosts only.
# For local plaintext mode or rollback without MITM, replace the placeholder with the real credential.
# Never commit real credentials.
TELEGRAM_BOT_TOKEN=__vault_TELEGRAM_BOT_TOKEN__
# Non-secret positive numeric Telegram user ID (compared in-process; not a placeholder).
TELEGRAM_OWNER_ID=
# Optional. Telegram Bot API root override (e.g. a reverse proxy such as a Cloudflare Worker)
# for hosts that cannot reach api.telegram.org directly. An https URL prefix without query or
# fragment; the client appends /bot<token>/<method>.
# TELEGRAM_API_ROOT=
# One of: anthropic, openai, deepseek, google, xai, mistral, groq,
# moonshotai, moonshotai-cn, minimax, zai, openrouter.
# Only the API key variable for the selected provider is required.
MODEL_PROVIDER=deepseek
MODEL_ID=
# ANTHROPIC_API_KEY=__vault_ANTHROPIC_API_KEY__
# OPENAI_API_KEY=__vault_OPENAI_API_KEY__
DEEPSEEK_API_KEY=__vault_DEEPSEEK_API_KEY__
# GEMINI_API_KEY=__vault_GEMINI_API_KEY__
# XAI_API_KEY=__vault_XAI_API_KEY__
# MISTRAL_API_KEY=__vault_MISTRAL_API_KEY__
# GROQ_API_KEY=__vault_GROQ_API_KEY__
# MOONSHOT_API_KEY=__vault_MOONSHOT_API_KEY__
# MINIMAX_API_KEY=__vault_MINIMAX_API_KEY__
# ZAI_API_KEY=__vault_ZAI_API_KEY__
# OPENROUTER_API_KEY=__vault_OPENROUTER_API_KEY__
DATA_DIR=./data
# Optional. Defaults to <DATA_DIR>/mcp.json. An explicit path must exist and be valid.
# MCP_CONFIG=./data/mcp.json
# Optional GitHub MCP uses Authorization: Bearer __vault_GITHUB_MCP_TOKEN__ in the
# external mcp.json, NOT a PAT environment variable. See docs/github-access.md.
# OpenBao logical path: secret/aster/GITHUB_MCP_TOKEN (field value).
# Credential release host: api.githubcopilot.com only; provision separately.
# Keep mcp.json, approved declarations and all secret mappings outside the repository.
# Optional DeepSeek Search/Fetch credential for the built-in web_search and web_fetch tools.
# Keep it separate from the model key so web access can be enabled or rotated independently.
# DEEPSEEK_WEB_API_KEY=__vault_DEEPSEEK_WEB_API_KEY__
# Optional PTC / code mode. The codemode tool runs model-written JavaScript in a QuickJS WASM
# sandbox whose only capability is calling allowlisted tools. Disabled unless set to 1.
# Nested calls are serialized and their results do not enter the conversation.
# CODEMODE_ENABLED=0
# CODEMODE_SCRIPT_FIRST=1
# CODEMODE_TIMEOUT_MS=240000
# CODEMODE_MEMORY_LIMIT_BYTES=134217728
# Memory system. All optional; the commented values are the code defaults
# (src/memory/contracts.ts MEMORY_BUDGET_DEFAULTS and src/config.ts). Invalid values fail startup.
# Set MEMORY_ENABLED=0 to disable the whole memory system (pre-MEM-07 behavior).
# MEMORY_ENABLED=1
# MEMORY_BACKGROUND_TARGET_TOKENS=49152
# MEMORY_RECENT_VERBATIM_TOKENS=16384
# MEMORY_SNAPSHOT_TOKENS=6144
# MEMORY_NARRATIVE_TOKENS=3072
# MEMORY_INSTRUCTIONS_TOKENS=8192
# MEMORY_SEARCH_RESULT_TOKENS=4096
# MEMORY_REQUEST_SEARCH_TOKENS=8192
# MEMORY_EVALUATE_AFTER_USER_TURNS=20
# MEMORY_RESERVE_TOKENS=16384
# MEMORY_TIMEZONE=UTC
# MEMORY_ARCHIVE_TIMEOUT_MS=60000
# One-time reminders. Enabled by default; REMINDERS_ENABLED=0 disables the tools and scheduler.
# Limits are per owner conversation; invalid values fail startup. See docs/reminders.md.
# REMINDERS_ENABLED=1
# REMINDERS_MAX_PENDING=100
# REMINDERS_MAX_PER_HOUR=20
# REMINDERS_MAX_HORIZON_DAYS=366
# Proactive Loop V1. Disabled unless PROACTIVE_ENABLED=1, which also requires
# DEEPSEEK_WEB_API_KEY (the only discovery channel). Times are host settings; the model never
# supplies them. Invalid values fail startup even while disabled. See docs/proactive-loop.md.
# PROACTIVE_ENABLED=0
# PROACTIVE_DAILY_AT=09:00
# PROACTIVE_TIMEZONE=UTC
# PROACTIVE_MAX_PER_DAY=1
# PROACTIVE_MAX_TOOL_CALLS=20
# PROACTIVE_MAX_TOKENS=60000
# PROACTIVE_TIMEOUT_MS=180000
# PROACTIVE_CONTEXT_MAX_CHARS=12000
# PROACTIVE_RECENT_DAYS=3
# Optional Langfuse Cloud tracing. Enabled only when both keys are set; leave them unset to keep
# tracing off. LANGFUSE_BASE_URL defaults to https://cloud.langfuse.com (LANGFUSE_HOST is accepted
# as an alias). LANGFUSE_TRACING_ENABLED=0 disables tracing while keeping the keys.
# In MITM mode the secret key uses an OpenBao placeholder; the proxy decodes Basic credentials
# before substituting. The public key is not secret and may stay plaintext.
# See docs/langfuse-tracing.md.
# LANGFUSE_PUBLIC_KEY=
# MITM mode uses this form; non-MITM mode puts the plaintext secret here instead.
# LANGFUSE_SECRET_KEY=__vault_LANGFUSE_SECRET_KEY__
# LANGFUSE_BASE_URL=
# LANGFUSE_TRACING_ENABLED=
# LANGFUSE_TRACING_ENVIRONMENT=production
# Optional remote tool execution. Leave EXECUTION_MODE unset for local execution.
# Legacy SSH transport: docker-compose.execution.yml sets these for the app container; the broker's
# SSH target, key path and known-hosts path are host-side configuration and never belong in this file.
# EXECUTION_MODE=remote
# EXECUTION_BROKER_SOCKET=/run/aster/execution/broker.sock
# EXECUTION_REMOTE_CWD=/home/<execution-user>/workspace
# EXECUTION_DEFAULT_TIMEOUT_SECONDS=300
# EXECUTION_MAX_TIMEOUT_SECONDS=3600
# EXECUTION_BROKER_CONNECT_TIMEOUT_MS=5000
#
# Whole-line RPC: docker-compose.rpc.yml sets the app to the Unix transport and starts the
# host-network gateway. Only the gateway reads the certificate directory; the app container never
# receives the client key. EXECUTION_RPC_ADDRESS is the agent's private address.
# EXECUTION_MODE=remote
# EXECUTION_REMOTE_TRANSPORT=rpc
# EXECUTION_REMOTE_CWD=/shared/aster
# EXECUTION_RPC_ADDRESS=10.1.0.15:9443
# EXECUTION_RPC_SERVER_NAME=execution.internal
# EXECUTION_RPC_CERT_DIR=/home/<user>/Aster/secrets/execution-rpc
# CODEMODE_ENABLED=1
