# Secret variables (ending in _KEY or _TOKEN) use __vault_<NAME>__ placeholders in MITM mode
# (docker-compose.mitm.yml + deploy/openbao-mitm). The MITM proxy swaps each placeholder for the
# value stored at OpenBao KV path secret/aster/<NAME> on allowlisted outbound hosts only.
# For local plaintext mode or rollback without MITM, replace the placeholder with the real credential.
# Never commit real credentials.
# The web adapter is the only conversation entry: one owner, one HTTP surface. The owner authenticates
# with the password set by `npm run web:set-password`; there is no bot token. Every WEB_* variable is
# optional; the commented values are the code defaults.
# WEB_OWNER_ID is the internal sender id the agent sees (1-64 characters of [A-Za-z0-9._-]); it is not
# a login name and never creates a second user.
# WEB_OWNER_ID=owner
# WEB_PORT=8787
# WEB_HOST=0.0.0.0
# Trust X-Forwarded-For from the local reverse proxy for the login rate limit (0 or 1).
# WEB_TRUST_PROXY=0
# Extra origins allowed to call the API (comma-separated scheme://authority, no path). Same-origin and
# the localhost/WebView defaults need no entry.
# WEB_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://localhost,http://tauri.localhost,tauri://localhost,capacitor://localhost
# WEB_SESSION_TTL_DAYS=30
# Directory of the built frontend, resolved from the process working directory.
# WEB_STATIC_DIR=web/dist
# Older builds read CHANNEL, TELEGRAM_*, SLACK_* and STYLE_LEARNING. This build ignores them and says
# so once at startup; remove them from an upgraded .env to keep the file honest.
# One of: anthropic, openai, deepseek, google, xai, mistral, groq,
# moonshotai, moonshotai-cn, minimax, zai, openrouter, or a provider id declared in
# DATA_DIR/providers.json.
# Only the API key variable for the selected provider is required. A declared provider names its own
# key variable in its declaration (apiKeyEnv), and that name is what .env must set.
MODEL_PROVIDER=deepseek
MODEL_ID=
# Optional model failover. Empty means off and changes nothing in the request path. Otherwise a
# comma-separated provider:model list, tried in order after MODEL_ID. Entries must exist in the
# provider's catalog; the primary may not be repeated. The whole-chain failure message is
# "模型暂时不可用"; per-model details go to the process log only.
# MODEL_FALLBACKS=magpie:commandcode/deepseek/deepseek-v4.1-flash
# Optional. Defaults to 90000 (90s) and requires MODEL_FALLBACKS. Bounds one model request; when
# it expires the next model in the chain takes over. A successful switch is sticky: later requests
# start at that fallback and the primary is not retried until a manual switch back. The selection
# is stored in DATA_DIR/model-selection.json; the owner can return to the primary with `$model
# primary` in chat (or delete the file). With MODEL_FALLBACKS set, `$model` also lists and selects
# OpenCode/Command Code DeepSeek, GLM and Gemini Flash models from the live catalog.
# MODEL_REQUEST_TIMEOUT_MS=90000
# ANTHROPIC_API_KEY=__vault_ANTHROPIC_API_KEY__
# OPENAI_API_KEY=__vault_OPENAI_API_KEY__
DEEPSEEK_API_KEY=__vault_DEEPSEEK_API_KEY__
# GEMINI_API_KEY=__vault_GEMINI_API_KEY__
# XAI_API_KEY=__vault_XAI_API_KEY__
# MISTRAL_API_KEY=__vault_MISTRAL_API_KEY__
# GROQ_API_KEY=__vault_GROQ_API_KEY__
# MOONSHOT_API_KEY=__vault_MOONSHOT_API_KEY__
# MINIMAX_API_KEY=__vault_MINIMAX_API_KEY__
# ZAI_API_KEY=__vault_ZAI_API_KEY__
# OPENROUTER_API_KEY=__vault_OPENROUTER_API_KEY__
DATA_DIR=./data
# Optional. Defaults to <DATA_DIR>/mcp.json. An explicit path must exist and be valid.
# MCP_CONFIG=./data/mcp.json
# Optional custom model providers (self-hosted OpenAI-compatible gateways). Defaults to
# <DATA_DIR>/providers.json; a missing default file means no declared providers, while an explicit
# path must exist and parse. The declaration holds addresses and credential VARIABLE NAMES only --
# never a key. A declared provider that lists its models from its own /models endpoint makes the
# startup config check reach that endpoint, so it is no longer offline.
# PROVIDERS_CONFIG=./data/providers.json
# A declared provider names its own key variable, and that name must match the MITM placeholder and
# the OpenBao path secret/aster/<NAME>. Example for a provider declared with apiKeyEnv MAGPIE_API_KEY
# (allowlist entry: the gateway's hosts, no port):
# MAGPIE_API_KEY=__vault_MAGPIE_API_KEY__
# Optional GitHub MCP uses Authorization: Bearer __vault_GITHUB_MCP_TOKEN__ in the
# external mcp.json, NOT a PAT environment variable.
# OpenBao logical path: secret/aster/GITHUB_MCP_TOKEN (field value).
# Credential release host: api.githubcopilot.com only; provision separately.
# Keep mcp.json, approved declarations and all secret mappings outside the repository.
# Optional DeepSeek Search/Fetch credential for the built-in web_search and web_fetch tools.
# Keep it separate from the model key so web access can be enabled or rotated independently.
# DEEPSEEK_WEB_API_KEY=__vault_DEEPSEEK_WEB_API_KEY__
# Optional Exa Search credential for the built-in exa_search tool. Each built-in web provider is
# registered only while its own credential is set, so the three tools can be enabled independently.
# DEEPSEEK_WEB_API_KEY and EXA_API_KEY may both be set: the model then gets both search tools.
# EXA_API_KEY=__vault_EXA_API_KEY__
# Memory system. Always enabled; all settings optional. The commented values are the code defaults
# (src/memory/contracts.ts MEMORY_BUDGET_DEFAULTS and src/config.ts). Invalid values fail startup.
# A leftover MEMORY_ENABLED is ignored and named once at startup, never by value.
# MEMORY_BACKGROUND_TARGET_TOKENS=49152
# MEMORY_RECENT_VERBATIM_TOKENS=16384
# MEMORY_SNAPSHOT_TOKENS=6144
# MEMORY_NARRATIVE_TOKENS=3072
# MEMORY_INSTRUCTIONS_TOKENS=8192
# MEMORY_SEARCH_RESULT_TOKENS=4096
# MEMORY_REQUEST_SEARCH_TOKENS=8192
# MEMORY_EVALUATE_AFTER_USER_TURNS=20
# MEMORY_RESERVE_TOKENS=16384
# MEMORY_TIMEZONE=UTC
# MEMORY_ARCHIVE_TIMEOUT_MS=60000
# Core memory (MemFS): a git repository edited with the ordinary file tools. Only the root MEMORY.md
# is injected; every other file is read on demand. MEMORY_FS_DIR must be an absolute path and
# defaults to <DATA_DIR>/memory-fs. The token budget accepts 256..65536.
# MEMORY_FS_ENABLED=1
# MEMORY_FS_DIR=/data/memory-fs
# MEMORY_FS_CORE_TOKENS=4096

# Dreaming: background consolidation of core memory in an isolated git worktree.
# Off when MEMORY_FS_ENABLED=0 (there is no repository to write). Every value is still validated.
# DREAMING_ENABLED=1
# DREAMING_TURNS=20
# DREAMING_ON_COMPACTION=1
# DREAMING_BEHAVIOR=auto-launch
# DREAMING_REVIEW=1
# DREAMING_DRY_RUN=0
# DREAMING_TIMEOUT_MS=120000
# One-time reminders. Enabled by default; REMINDERS_ENABLED=0 disables the tools and scheduler.
# Limits are per owner conversation; invalid values fail startup.
# REMINDERS_ENABLED=1
# REMINDERS_MAX_PENDING=100
# REMINDERS_MAX_PER_HOUR=20
# REMINDERS_MAX_HORIZON_DAYS=366
# Optional Langfuse Cloud tracing. Enabled only when both keys are set; leave them unset to keep
# tracing off. LANGFUSE_BASE_URL defaults to https://cloud.langfuse.com (LANGFUSE_HOST is accepted
# as an alias). LANGFUSE_TRACING_ENABLED=0 disables tracing while keeping the keys.
# In MITM mode the secret key uses an OpenBao placeholder; the proxy decodes Basic credentials
# before substituting. The public key is not secret and may stay plaintext.
# LANGFUSE_PUBLIC_KEY=
# MITM mode uses this form; non-MITM mode puts the plaintext secret here instead.
# LANGFUSE_SECRET_KEY=__vault_LANGFUSE_SECRET_KEY__
# LANGFUSE_BASE_URL=
# LANGFUSE_TRACING_ENABLED=
# LANGFUSE_TRACING_ENVIRONMENT=production

# Browser automation. Names the CDP endpoint of a headless Chrome the
# agent drives with the agent-browser CLI. The CLI reads this variable itself; the application only
# uses its presence to decide whether the system prompt mentions the browser at all, so an
# installation without a browser host keeps a prompt that never points at a missing command.
# Normally supplied by docker-compose.browser.yml rather than set here. Not a credential, but it is
# the browser's whole control channel: keep it on a private address the agent's process can reach.
# AGENT_BROWSER_CDP=http://172.18.0.1:9222

# Event tracking. On by default, matching the code: with no watcher row nothing is fetched. Set
# WATCHERS_ENABLED=0 to disable the loop entirely. GitHub events arrive through a relay (webhook in,
# long poll out) so this container still opens no port; feeds are fetched directly. Setting only one
# of the two relay variables is a startup error, not a silent half-mode.
# WATCHERS_ENABLED=1
# WATCHERS_MAX_ACTIVE=20
# WATCHERS_MAX_PER_HOUR=10
# WATCHERS_FEED_INTERVAL_SEC=600
# WATCHERS_X_INTERVAL_SEC=900
# WATCHERS_GITHUB_RECONCILE_MIN=15
# WATCHERS_FETCH_TIMEOUT_MS=15000
# WATCHERS_RELAY_URL=
# WATCHERS_RELAY_TOKEN=
# WATCHERS_GITHUB_TOKEN=

# Skills: reusable procedures stored as <dir>/<name>/SKILL.md with `name` and `description` in the
# frontmatter. Startup reads only the frontmatter and puts names + descriptions in the prompt; a
# procedure's body is read when the model calls skill_load. A missing directory is an empty index.
# SKILLS_ENABLED=1
# SKILLS_DIR=

# Standing tasks: recurring work the host runs without a chat message (daily brief, repeating
# reminder). Enabled by default. ROUTINES_PAUSED=1 is the kill switch: the scheduler claims nothing
# and no run is dispatched, while every task keeps its schedule. Times are wall-clock times in
# ROUTINES_TIMEZONE. ROUTINES_MAX_RUNS_PER_DAY=0 means no hard cap; the daily usage summary at
# ROUTINES_SUMMARY_TIME and the anomaly alert remain the backstop.
# ROUTINES_ENABLED=1
# ROUTINES_PAUSED=0
# ROUTINES_TIMEZONE=Asia/Shanghai
# ROUTINES_MAX_PER_OWNER=50
# ROUTINES_MIN_INTERVAL_MINUTES=5
# ROUTINES_MAX_RUNS_PER_DAY=0
# ROUTINES_RUN_TIMEOUT_MS=600000
# ROUTINES_SUMMARY_ENABLED=1
# ROUTINES_SUMMARY_TIME=21:00
# ROUTINES_RETENTION_DAYS=90
