TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# One of: anthropic, openai, deepseek, google, xai, mistral, groq,
# moonshotai, moonshotai-cn, minimax, zai, openrouter.
# Only the API key variable for the selected provider is required.
MODEL_PROVIDER=anthropic
MODEL_ID=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# MOONSHOT_API_KEY=
# MINIMAX_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
DATA_DIR=./data
# Optional. Defaults to <DATA_DIR>/mcp.json. An explicit path must exist and be valid.
# MCP_CONFIG=./data/mcp.json
# Tool credential brokering: see docs/agent-vault.md and deploy/agent-vault/*.example.
# AGENT_VAULT_ENABLED=1
# HTTP_PROXY=http://proxy-token:vault@broker:14322
# HTTPS_PROXY=http://proxy-token:vault@broker:14322
# Set these before Node starts (not from code):
# NODE_USE_ENV_PROXY=1
# NODE_EXTRA_CA_CERTS=/absolute/path/agent-vault-ca.pem
# NO_PROXY=localhost,127.0.0.1,::1
