TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Or read the owner ID from a file instead (for example a secret-manager export); set only one.
# TELEGRAM_OWNER_ID_FILE=/absolute/path/telegram-owner-id
# One of: anthropic, openai, deepseek, google, xai, mistral, groq,
# moonshotai, moonshotai-cn, minimax, zai, openrouter.
# Only the API key variable for the selected provider is required.
MODEL_PROVIDER=anthropic
MODEL_ID=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# MOONSHOT_API_KEY=
# MINIMAX_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
DATA_DIR=./data
# Optional. Defaults to <DATA_DIR>/mcp.json. An explicit path must exist and be valid.
# MCP_CONFIG=./data/mcp.json
# Memory system (MEM-01..MEM-07). All optional; defaults shown. Invalid values fail startup.
# Set MEMORY_ENABLED=0 to disable the whole memory system (pre-MEM-07 behavior).
# MEMORY_ENABLED=1
# MEMORY_BACKGROUND_TARGET_TOKENS=49152
# MEMORY_RECENT_VERBATIM_TOKENS=16384
# MEMORY_SNAPSHOT_TOKENS=8192
# MEMORY_NARRATIVE_TOKENS=3072
# MEMORY_INSTRUCTIONS_TOKENS=4096
# MEMORY_SEARCH_RESULT_TOKENS=4096
# MEMORY_REQUEST_SEARCH_TOKENS=8192
# MEMORY_EVALUATE_AFTER_USER_TURNS=20
# MEMORY_RESERVE_TOKENS=16384
# MEMORY_TIMEZONE=UTC
# MEMORY_ARCHIVE_TIMEOUT_MS=120000
# Tool credential brokering: see docs/agent-vault.md and deploy/agent-vault/*.example.
# With AGENT_VAULT_ENABLED=1, TELEGRAM_BOT_TOKEN and the selected provider key must be __vault_KEY__
# placeholders, and TELEGRAM_OWNER_ID must be replaced by TELEGRAM_OWNER_ID_FILE.
# AGENT_VAULT_ENABLED=1
# HTTP_PROXY=http://proxy-token:vault@broker:14322
# HTTPS_PROXY=http://proxy-token:vault@broker:14322
# Set these before Node starts (not from code):
# NODE_USE_ENV_PROXY=1
# NODE_EXTRA_CA_CERTS=/absolute/path/agent-vault-ca.pem
# NO_PROXY=localhost,127.0.0.1,::1
