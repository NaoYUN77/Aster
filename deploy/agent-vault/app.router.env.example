# Copy to private/app.router.env for docker-compose.router.yml.
TELEGRAM_BOT_TOKEN=__vault_TELEGRAM_BOT_TOKEN__
TELEGRAM_OWNER_ID_FILE=/run/secrets/telegram-owner-id
MODEL_PROVIDER=openai
MODEL_ID=
OPENAI_API_KEY=sk-__vault_OPENAI_API_KEY__
# URL-encode the router client password. Do not put vault agent tokens in the app.
HTTP_PROXY=http://app:REPLACE_ROUTER_PASSWORD@127.0.0.1:14323
HTTPS_PROXY=http://app:REPLACE_ROUTER_PASSWORD@127.0.0.1:14323
NPM_CONFIG_CACHE=/data/.npm
