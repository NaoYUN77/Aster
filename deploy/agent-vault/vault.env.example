# Copy to private/vault.env; never mount this file into the application container.
# Protects the broker's local encrypted data volume (credentials and CA private key).
# This is not the Infisical password and is never sent to the application. Losing it
# makes the existing volume unrecoverable; use `agent-vault master-password change` to rotate.
AGENT_VAULT_MASTER_PASSWORD=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
AGENT_VAULT_ADDR=http://localhost:14321
