{
  "listen": "127.0.0.1:14323",
  "upstream_proxy": "172.30.82.2:14322",
  "client_auth": {
    "username": "app",
    "password_files": [
      "/etc/aster-router/client-password"
    ]
  },
  "routes": [
    {
      "name": "telegram",
      "host": "api.telegram.org",
      "port": 443,
      "vault": "telegram",
      "agent_token_file": "/etc/aster-router/agent-token-telegram"
    },
    {
      "name": "deepseek",
      "host": "api.deepseek.com",
      "port": 443,
      "vault": "deepseek",
      "agent_token_file": "/etc/aster-router/agent-token-deepseek"
    },
    {
      "name": "github",
      "host": "api.github.com",
      "port": 443,
      "vault": "tools",
      "agent_token_file": "/etc/aster-router/agent-token-tools"
    }
  ],
  "allowed_ports": [
    443
  ],
  "timeouts": {
    "client_header": "10s",
    "dial": "5s",
    "upstream_header": "15s",
    "idle": "10m",
    "shutdown": "15s"
  },
  "limits": {
    "max_connections": 256,
    "max_connections_per_route": 64,
    "max_header_bytes": 16384,
    "max_error_body_bytes": 4096
  },
  "log": {
    "level": "info",
    "format": "json",
    "access": true
  },
  "health_listen": "127.0.0.1:14324"
}
