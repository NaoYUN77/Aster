# Copy to private/app.env. Secrets live in Infisical; only placeholders and non-secret settings here.
TELEGRAM_BOT_TOKEN=__vault_TELEGRAM_BOT_TOKEN__
# The owner ID is not a request credential, so the proxy cannot inject it. It is stored in
# Infisical and exported to this file at deploy time (see docs/agent-vault.md). Compose mounts
# file secrets as bind mounts, so the source must be readable by uid 1000 (use mode 644).
TELEGRAM_OWNER_ID_FILE=/run/secrets/telegram-owner-id
# Non-secret model selection. The provider key below is a placeholder replaced by the Vault rule.
MODEL_PROVIDER=openai
MODEL_ID=
# pi-ai 1.3.0 treats a non "sk-" key sent to OpenAI as a ChatGPT sign-in token, so keep the prefix.
OPENAI_API_KEY=sk-__vault_OPENAI_API_KEY__
# Proxy role only. URL-encode token and vault name if necessary; both URLs must match.
HTTP_PROXY=http://REPLACE_PROXY_TOKEN:personal-agent@172.30.82.2:14322
HTTPS_PROXY=http://REPLACE_PROXY_TOKEN:personal-agent@172.30.82.2:14322
NPM_CONFIG_CACHE=/data/.npm
