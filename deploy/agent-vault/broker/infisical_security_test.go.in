package infisical

import (
	"bytes"
	"context"
	"crypto/tls"
	"crypto/x509"
	"fmt"
	"io"
	"log"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	sdk "github.com/infisical/go-sdk"
)

const securityMarker = "SYNTHETIC_SECRET_MUST_NEVER_APPEAR"
const loginPath = "/api/v1/auth/universal-auth/login"
const renewPath = "/api/v1/auth/token/renew"
const secretsPath = "/api/v3/secrets/raw"

var securityVault = VaultConfig{ProjectID: securityMarker, Environment: "test", SecretPath: "/"}

type securityLog struct {
	mu sync.Mutex
	buf bytes.Buffer
}
func (b *securityLog) Write(p []byte) (int, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	return b.buf.Write(p)
}
func (b *securityLog) String() string {
	b.mu.Lock()
	defer b.mu.Unlock()
	return b.buf.String()
}

func securityServer(t *testing.T, fn http.HandlerFunc) (*httptest.Server, *http.Transport) {
	t.Helper()
	srv := httptest.NewUnstartedServer(fn)
	srv.Config.ErrorLog = log.New(io.Discard, "", 0)
	srv.StartTLS()
	t.Cleanup(srv.Close)
	roots := x509.NewCertPool()
	roots.AddCert(srv.Certificate())
	return srv, &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots}}
}

func securityClient(t *testing.T, srv *httptest.Server, base *http.Transport) (*Client, *securityLog) {
	t.Helper()
	t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_ID", "synthetic-client")
	t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET", securityMarker)
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	logs := &securityLog{}
	client, err := newClient(ctx, slog.New(slog.NewTextHandler(logs, nil)), srv.URL, base)
	if err != nil {
		t.Fatalf("new client: %v", err)
	}
	return client, logs
}

func securityJSON(w http.ResponseWriter, body string) {
	w.Header().Set("Content-Type", "application/json")
	_, _ = io.WriteString(w, body)
}
func securityToken(w http.ResponseWriter, ttl int, token string) {
	securityJSON(w, fmt.Sprintf(`{"accessToken":%q,"expiresIn":%d,"accessTokenMaxTTL":3600,"tokenType":"Bearer"}`, token, ttl))
}
func assertSecuritySafe(t *testing.T, err error, logs *securityLog) {
	t.Helper()
	text := logs.String()
	if err != nil { text += err.Error() }
	for _, forbidden := range []string{securityMarker, "workspaceId=", "secretPath=", "clientSecret", "accessToken", "https://peer-controlled.invalid"} {
		if strings.Contains(text, forbidden) { t.Fatalf("sensitive diagnostic contains %q", forbidden) }
	}
}

func TestReviewedOriginValidation(t *testing.T) {
	for _, raw := range []string{"", "app.infisical.com", "http://example.test", "https://user:pass@example.test", "https://example.test/", "https://example.test/api", "https://example.test?", "https://example.test?secret="+securityMarker, "https://example.test#", "https://example.test#secret", "https://example.test:", "https://example.test:0", "https://example.test:65536"} {
		if _, err := infisicalOrigin(raw); err != errInfisicalOrigin { t.Errorf("accepted invalid origin or unsafe error: %q", raw) }
	}
	for _, raw := range []string{"https://example.test", "https://example.test:443", "https://[::1]:12345"} {
		if _, err := infisicalOrigin(raw); err != nil { t.Errorf("rejected origin: %q", raw) }
	}
}

func TestReviewedLoginSecretsAndProjectSlug(t *testing.T) {
	var login, fetch, slug atomic.Int32
	srv, base := securityServer(t, func(w http.ResponseWriter, r *http.Request) {
		switch r.URL.Path {
		case loginPath:
			login.Add(1)
			body, _ := io.ReadAll(r.Body)
			if !bytes.Contains(body, []byte(securityMarker)) { t.Error("real SDK login did not send credentials") }
			securityToken(w, 3600, "synthetic-token")
		case secretsPath:
			fetch.Add(1)
			if r.Header.Get("Authorization") != "Bearer synthetic-token" { t.Error("SDK bearer missing") }
			securityJSON(w, `{"secrets":[{"secretKey":"API_KEY","secretValue":"synthetic-value"}]}`)
		default:
			slug.Add(1)
			if r.Header.Get("Authorization") != "Bearer synthetic-token" { t.Error("project bearer missing") }
			securityJSON(w, `{"workspace":{"slug":"test-project"}}`)
		}
	})
	client, logs := securityClient(t, srv, base)
	values, err := client.FetchSecrets(context.Background(), securityVault)
	if err != nil || len(values) != 1 || values[0].Value != "synthetic-value" { t.Fatalf("secret data changed: %v", err) }
	project, err := client.projectSlug(context.Background(), "test-project")
	if err != nil || project != "test-project" { t.Fatalf("project lookup: %v", err) }
	if login.Load() != 1 || fetch.Load() != 1 || slug.Load() != 1 { t.Fatal("real client paths not exercised") }
	assertSecuritySafe(t, err, logs)
}

func TestReviewedErrorsDoNotContainResponseOrURL(t *testing.T) {
	for _, operation := range []string{"login", "secrets", "slug"} {
		for _, status := range []int{400, 422, 500} {
			t.Run(fmt.Sprintf("%s/%d", operation, status), func(t *testing.T) {
				srv, base := securityServer(t, func(w http.ResponseWriter, r *http.Request) {
					if r.URL.Path == loginPath && operation != "login" { securityToken(w, 3600, "synthetic-token"); return }
					w.Header().Set("X-Request-Id", securityMarker)
					w.WriteHeader(status)
					_, _ = io.WriteString(w, `{"message":"`+securityMarker+`","accessToken":"`+securityMarker+`"}`)
				})
				t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_ID", "synthetic-client")
				t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET", securityMarker)
				ctx, cancel := context.WithCancel(context.Background()); defer cancel()
				logs := &securityLog{}
				client, err := newClient(ctx, slog.New(slog.NewTextHandler(logs, nil)), srv.URL, base)
				if operation == "secrets" && err == nil {
					// Inspect the SDK error itself too, before the wrapper sanitizes it.
					_, err = client.sdk.Secrets().ListSecrets(sdk.ListSecretsOptions{ProjectID: securityMarker, Environment: "test", SecretPath: "/"})
				} else if operation == "slug" && err == nil { _, err = client.projectSlug(ctx, securityMarker) }
				if err == nil { t.Fatal("expected error") }
				if !strings.Contains(err.Error(), fmt.Sprint(status)) { t.Fatal("safe HTTP status missing") }
				assertSecuritySafe(t, err, logs)
			})
		}
	}
}

func TestReviewedRedirectsAreNeverFollowed(t *testing.T) {
	for _, operation := range []string{"login", "secrets", "slug"} {
		for _, status := range []int{301, 302, 303, 307, 308} {
			for _, sameOrigin := range []bool{false, true} {
				t.Run(fmt.Sprintf("%s/%d/same-origin=%t", operation, status, sameOrigin), func(t *testing.T) {
					var redirected atomic.Int32
					sink, _ := securityServer(t, func(w http.ResponseWriter, r *http.Request) { redirected.Add(1); w.WriteHeader(500) })
					srv, base := securityServer(t, func(w http.ResponseWriter, r *http.Request) {
						if r.URL.Path == "/sink" { redirected.Add(1); return }
						if r.URL.Path == loginPath && operation != "login" { securityToken(w, 3600, "synthetic-token"); return }
						target := sink.URL + "/sink?secret="+securityMarker
						if sameOrigin { target = "/sink?secret="+securityMarker }
						w.Header().Set("Location", target)
						w.WriteHeader(status)
					})
					t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_ID", "synthetic-client")
					t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET", securityMarker)
					ctx, cancel := context.WithCancel(context.Background()); defer cancel()
					logs := &securityLog{}
					client, err := newClient(ctx, slog.New(slog.NewTextHandler(logs, nil)), srv.URL, base)
					if operation == "secrets" && err == nil { _, err = client.FetchSecrets(ctx, securityVault) }
					if operation == "slug" && err == nil { _, err = client.projectSlug(ctx, securityMarker) }
					if err == nil || redirected.Load() != 0 { t.Fatal("redirect policy failed") }
					assertSecuritySafe(t, err, logs)
				})
			}
		}
	}
}

func TestReviewedAutomaticRefreshAndReauthentication(t *testing.T) {
	for _, failure := range []string{"", "422", "redirect"} {
		t.Run(failure, func(t *testing.T) {
			var logins, renewals, leaked atomic.Int32
			renewed := make(chan struct{}, 1)
			sink, _ := securityServer(t, func(w http.ResponseWriter, r *http.Request) { leaked.Add(1) })
			srv, base := securityServer(t, func(w http.ResponseWriter, r *http.Request) {
				if r.URL.Path == loginPath {
					n := logins.Add(1)
					if n == 1 { securityToken(w, 1, "synthetic-old-token"); return }
					securityToken(w, 3600, "synthetic-new-token")
					return
				}
				if r.URL.Path == renewPath {
					renewals.Add(1)
					body, _ := io.ReadAll(r.Body)
					if !bytes.Contains(body, []byte("synthetic-old-token")) { t.Error("refresh did not use real SDK token") }
					switch failure {
					case "422": w.WriteHeader(422); _, _ = io.WriteString(w, securityMarker)
					case "redirect": w.Header().Set("Location", sink.URL+"?secret="+securityMarker); w.WriteHeader(307)
					default: securityToken(w, 3600, "synthetic-new-token")
					}
					select { case renewed <- struct{}{}: default: }
					return
				}
				securityJSON(w, `{"secrets":[]}`)
			})
			client, logs := securityClient(t, srv, base)
			// No manual renewal API: wait for the actual SDK lifecycle goroutine.
			select { case <-renewed: case <-time.After(4*time.Second): t.Fatal("automatic SDK renewal did not run") }
			deadline := time.Now().Add(time.Second)
			for client.sdk.Auth().GetAccessToken() != "synthetic-new-token" && time.Now().Before(deadline) { time.Sleep(time.Millisecond) }
			_, err := client.FetchSecrets(context.Background(), securityVault)
			if err != nil || renewals.Load() == 0 || leaked.Load() != 0 { t.Fatal("refresh failed or left origin") }
			if failure != "" && logins.Load() < 2 { t.Fatal("SDK reauthentication fallback not exercised") }
			assertSecuritySafe(t, err, logs)
		})
	}
}

func TestReviewedTransportRejectsOtherOriginAndUntrustedTLS(t *testing.T) {
	var calls atomic.Int32
	srv, base := securityServer(t, func(w http.ResponseWriter, r *http.Request) { calls.Add(1); securityToken(w, 3600, "synthetic-token") })
	client := infisicalHTTPClient(srv.URL, base)
	for _, target := range []string{"http://"+strings.TrimPrefix(srv.URL, "https://"), "https://peer-controlled.invalid/?secret="+securityMarker} {
		res, err := client.Get(target)
		if res != nil { _ = res.Body.Close() }
		if err == nil || calls.Load() != 0 { t.Fatal("origin guard permitted request") }
	}
	// Even a mistakenly insecure host transport must be made verifying again.
	untrusted := base.Clone()
	untrusted.TLSClientConfig = &tls.Config{InsecureSkipVerify: true}
	t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_ID", "synthetic-client")
	t.Setenv("INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET", securityMarker)
	ctx, cancel := context.WithCancel(context.Background()); defer cancel()
	logs := &securityLog{}
	_, err := newClient(ctx, slog.New(slog.NewTextHandler(logs, nil)), srv.URL, untrusted)
	if err == nil || calls.Load() != 0 { t.Fatal("untrusted TLS certificate accepted") }
	assertSecuritySafe(t, err, logs)
}

func TestReviewedSDKLoggerDropsAllArguments(t *testing.T) {
	logs := &securityLog{}
	logger := safeSDKLog{slog.New(slog.NewTextHandler(logs, nil))}
	_, _ = logger.Write([]byte(securityMarker))
	logger.Errorf(securityMarker+" %s", securityMarker)
	logger.Warnf(securityMarker+" %s", securityMarker)
	logger.Debugf(securityMarker+" %s", securityMarker)
	assertSecuritySafe(t, nil, logs)
	if logs.String() == "" { t.Fatal("safe diagnostics lost") }
}
