package mitm

import (
	"errors"
	"io"
	"net"
	"net/http"
	"os"
	"path"
	"strconv"
	"strings"

	"gopkg.in/yaml.v3"
)

// APIPolicy is the authoritative on-disk schema. Unknown/duplicate fields,
// multiple documents and noncanonical values are rejected. Rules are exact
// tuples; no regex, glob, prefix or implicit method expansion is supported.
// The vault name is the authenticated, resolved scope, never a client hint.
// Query/body/response semantics are outside this first-stage operation gate.
type APIPolicy struct {
	Version int       `yaml:"version"`
	Rules   []APIRule `yaml:"rules"`
}

type APIRule struct {
	Vault  string `yaml:"vault"`
	Target string `yaml:"target"`
	Method string `yaml:"method"`
	Path   string `yaml:"path"`
}

var errAPIPolicy = errors.New("API policy rejected")

// LoadAPIPolicy returns nil (deny all) when no policy was configured. An
// explicitly configured but unreadable/invalid file aborts server startup.
// The immutable snapshot is shared by all vaults until the broker is restarted.
func LoadAPIPolicy(filename string) (*APIPolicy, error) {
	if filename == "" {
		return nil, nil
	}
	f, err := os.Open(filename)
	if err != nil {
		return nil, errAPIPolicy
	}
	defer f.Close()
	return parseAPIPolicy(f)
}

func parseAPIPolicy(r io.Reader) (*APIPolicy, error) {
	data, err := io.ReadAll(io.LimitReader(r, (1<<20)+1))
	if err != nil || len(data) > 1<<20 {
		return nil, errAPIPolicy
	}
	d := yaml.NewDecoder(strings.NewReader(string(data)))
	d.KnownFields(true)
	var p APIPolicy
	if d.Decode(&p) != nil || p.Version != 1 || p.Rules == nil || len(p.Rules) > 1024 {
		return nil, errAPIPolicy
	}
	var extra any
	if d.Decode(&extra) != io.EOF {
		return nil, errAPIPolicy
	}
	seen := make(map[APIRule]bool)
	for _, rule := range p.Rules {
		if !validVault(rule.Vault) || !validTarget(rule.Target) || !validMethod(rule.Method) || !validAPIPath(rule.Path) || seen[rule] {
			return nil, errAPIPolicy
		}
		seen[rule] = true
	}
	return &p, nil
}

func validVault(v string) bool {
	if len(v) == 0 || len(v) > 128 {
		return false
	}
	for _, c := range v {
		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_') {
			return false
		}
	}
	return true
}

func validTarget(target string) bool {
	host, port, err := net.SplitHostPort(target)
	n, portErr := strconv.Atoi(port)
	if err != nil || portErr != nil || n < 1 || n > 65535 || strconv.Itoa(n) != port || host == "" || host != strings.ToLower(host) {
		return false
	}
	// Deliberately restrict this phase to exact DNS names/IPv4, excluding
	// Unicode, trailing dots, IP zones and alternative numeric spellings.
	if len(host) > 253 || strings.HasSuffix(host, ".") {
		return false
	}
	for _, label := range strings.Split(host, ".") {
		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
			return false
		}
		for _, c := range label {
			if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
				return false
			}
		}
	}
	return true
}

func validMethod(method string) bool {
	switch method {
	case "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS":
		return true
	}
	return false
}

func validAPIPath(p string) bool {
	if len(p) == 0 || len(p) > 2048 || p[0] != '/' || strings.Contains(p, "//") || path.Clean(p) != p {
		return false
	}
	for _, c := range p {
		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.ContainsRune("/-_.:~", c)) {
			return false
		}
	}
	return true
}

func (p *APIPolicy) allows(vault, target string, r *http.Request, tlsUpstream bool) bool {
	// Gate the incoming placeholder path before resolving credentials or path
	// substitutions. Percent encoding (including double encoding), alternate
	// path spellings and protocol upgrades cannot widen an exact rule.
	if p == nil || !tlsUpstream || r.URL == nil || r.URL.IsAbs() || r.URL.Opaque != "" ||
		r.URL.RawPath != "" || r.URL.Fragment != "" || !validAPIPath(r.URL.Path) ||
		r.Header.Get("Upgrade") != "" || r.Header.Get("X-HTTP-Method-Override") != "" ||
		r.Header.Get("X-Method-Override") != "" || r.Header.Get("X-HTTP-Method") != "" ||
		r.Header.Get("X-Original-URL") != "" || r.Header.Get("X-Rewrite-URL") != "" {
		return false
	}
	for _, rule := range p.Rules {
		if rule.Vault == vault && rule.Target == target && rule.Method == r.Method && rule.Path == r.URL.Path {
			return true
		}
	}
	return false
}
