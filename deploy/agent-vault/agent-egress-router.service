[Unit]
Description=Agent egress router for Agent Vault
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=agent-router
Group=agent-router
ExecStart=/usr/local/bin/agent-egress-router serve -config /etc/personal-agent/egress-router.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
UMask=0077
Environment=GOMAXPROCS=2

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The router only talks to Agent Vault on loopback. It does not need DNS or
# direct outbound access. If the broker is remote, change these lines and
# re-run the acceptance checks; remote brokers are not supported by default.
# If Docker publishes the broker through the bridge network instead of a
# loopback userland proxy, also allow the Docker bridge CIDR (for example
# 172.30.0.0/16) and verify that only the broker is reachable.
IPAddressDeny=any
IPAddressAllow=127.0.0.1 ::1

LimitNOFILE=8192
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
