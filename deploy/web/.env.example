# Copy to deploy/web/.env and fill in LOCAL DEVELOPMENT values only.
# This file must never contain production credentials.
#
# The stack is `aster-web`, volume `aster-web-data`, and DATA_DIR=/data inside its own volume.

CHANNEL=web
WEB_OWNER_ID=owner
WEB_PORT=8787
WEB_HOST=0.0.0.0
# Origins allowed to call the API from a Tauri/Capacitor WebView or the Vite dev server.
# This setting replaces the server defaults, so keep every origin the client actually uses.
# Capacitor's WebView origin is https://localhost (include it for the native shell).
WEB_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,http://tauri.localhost,tauri://localhost,capacitor://localhost
WEB_SESSION_TTL_DAYS=30
# Set to 1 only when the app is reachable exclusively through the bundled Caddy (X-Forwarded-For).
WEB_TRUST_PROXY=1

# The owner password is NOT an environment variable. Set it inside the container:
#   docker compose -f deploy/web/docker-compose.yml exec app node dist/src/web-set-password.js
# or for local development: DATA_DIR=./data-web npm run web:set-password

# Model provider + chain, unchanged from the existing runtime. Use development keys.
MODEL_PROVIDER=<provider>
MODEL_ID=<model-id>
MODEL_FALLBACKS=<provider:model>,<provider:model>
<PROVIDER>_API_KEY=<development-key>

# Memory: the test VM runs with it enabled. Set 0 only for a minimal local run.
MEMORY_ENABLED=1

# Connectors (GitHub/Gmail read-only, server-side OAuth). Secrets are files, never env values.
# The directory must be a read-only bind mount or Docker secret directory; missing files are
# named in a safe connection error and are never replaced by empty defaults.
CONNECTORS_ENABLED=1
ASTER_CONNECTOR_SECRET_DIR=/run/secrets/aster-connectors
# Public origin the OAuth provider redirects to; must match the OAuth app registration:
#   <CONNECTOR_OAUTH_REDIRECT_BASE>/api/v1/connectors/oauth/callback
CONNECTOR_OAUTH_REDIRECT_BASE=https://<dev-host>
CONNECTOR_HTTP_TIMEOUT_MS=15000
CONNECTOR_OAUTH_STATE_TTL_MS=600000
CONNECTOR_LEASE_TTL_MS=30000
# Comma-separated commands allowed for a local stdio MCP connector. Empty denies all.
CONNECTOR_STDIO_ALLOWLIST=
